DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/brewflow?schema=public"
SESSION_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (paiement par carte — requis pour activer le bouton « Carte » au POS)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Taux de conversion TND → EUR pour la facturation Stripe (la compta interne reste en TND)
STRIPE_TND_PER_UNIT="3.2"