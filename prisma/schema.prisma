generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SERVER
  KITCHEN
}

enum Unit {
  KG
  L
  PIECE
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  PRETE
  PAYEE
}

enum PaymentMethod {
  CASH
  STRIPE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Establishment {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  timezone  String   @default("Africa/Tunis")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  categories  Category[]
  ingredients Ingredient[]
  dishes      Dish[]
  tables      Table[]
  shifts      Shift[]
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            Role     @default(SERVER)
  establishmentId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
  stockEntries  StockEntry[]
  shifts        Shift[]

  @@index([establishmentId])
}

model Category {
  id              String   @id @default(cuid())
  name            String
  sortOrder       Int      @default(0)
  establishmentId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  dishes        Dish[]

  @@unique([establishmentId, name])
  @@index([establishmentId])
}

model Ingredient {
  id              String   @id @default(cuid())
  name            String
  unit            Unit     @default(KG)
  currentStock    Decimal  @default(0) @db.Decimal(12, 3)
  minThreshold    Decimal  @default(0) @db.Decimal(12, 3)
  costPerUnit     Decimal  @default(0) @db.Decimal(12, 3)
  imageUrl        String?
  establishmentId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment    Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  stockEntries      StockEntry[]

  @@unique([establishmentId, name])
  @@index([establishmentId])
}

model Dish {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 3)
  categoryId      String
  imageUrl        String?
  isActive        Boolean  @default(true)
  establishmentId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  establishment     Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  orderItems        OrderItem[]

  @@unique([establishmentId, name])
  @@index([categoryId])
  @@index([establishmentId])
}

model RecipeIngredient {
  id             String  @id @default(cuid())
  quantityNeeded Decimal @db.Decimal(12, 3)
  dishId         String
  ingredientId   String

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([dishId, ingredientId])
  @@index([ingredientId])
}

model StockEntry {
  id            String   @id @default(cuid())
  quantityAdded Decimal  @db.Decimal(12, 3)
  supplierName  String?
  date          DateTime @default(now())
  ingredientId  String
  userId        String
  createdAt     DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ingredientId])
  @@index([userId])
}

model Table {
  id              String   @id @default(cuid())
  number          Int
  zone            String?
  qrCode          String?  @unique
  establishmentId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@map("tables")
  @@unique([establishmentId, number])
  @@index([establishmentId])
}

model Order {
  id            String        @id @default(cuid())
  tableId       String
  status        OrderStatus   @default(EN_ATTENTE)
  totalAmount   Decimal       @db.Decimal(12, 3)
  paymentMethod PaymentMethod?
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  table      Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  payments   Payment[]

  @@index([tableId])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  dishId    String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish  @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([dishId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 3)
  transactionId String?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shift {
  id              String   @id @default(cuid())
  userId          String
  dayOfWeek       Int
  startTime       String
  endTime         String
  establishmentId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([establishmentId])
}